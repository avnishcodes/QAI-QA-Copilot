# ==============================================================================
# QAI-QA-Copilot: Private Staging Environment Configuration Template
# ==============================================================================
# Copy this file to .env.staging and supply real staging parameters.
# Never commit .env.staging to version control.
# ==============================================================================

# Staging domain / host name
STAGING_DOMAIN=qai.internal.example.com

# Mandatory Staging Proxy Auth: bcrypt hash for basicauth user 'qa_tester'
# Generate using:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext "YourPasswordHere"
STAGING_BASIC_AUTH_HASH=

# Mandatory Application API Token: 64-char random hex token for Bearer authorization
# Generate on Linux using: openssl rand -hex 32
QAI_API_TOKEN=

# Mandatory Staging Target Allowlist:
# Staging containers fail to start unless an explicit comma-separated hostname
# allowlist is configured. Supply only domains you own or have permission to test.
# Wildcard prefixes are supported (e.g., *.staging.example.com,app.qa.example.com).
# Private, loopback (127.0.0.1, localhost), and cloud metadata IPs are always
# blocked regardless of allowlist configuration.
#
# Replace the placeholder below with your authorized test domains before starting:
# Example: QAI_ALLOWED_HOSTS=app.staging.example.com,*.qa.example.com
QAI_ALLOWED_HOSTS=

# Optional: Gemini API Key and verified model name
# Leave GEMINI_API_KEY empty to run fully offline with deterministic safe actions.
# If configured, specify a verified public model name (e.g. gemini-1.5-flash or gemini-2.0-flash).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Worker concurrency limit (1-8, default 2)
QAI_MAX_CONCURRENT_WEBSITE_RUNS=2
