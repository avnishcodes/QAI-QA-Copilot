GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Optional. Defaults to backend/qai.db.
QAI_DATABASE_PATH=backend/qai.db
# Optional exact hosts or wildcard suffixes, comma-separated. The initial
# target host is allowed by default; private and metadata networks stay blocked.
QAI_ALLOWED_HOSTS=
# Maximum simultaneous website runs (1-8).
QAI_MAX_CONCURRENT_WEBSITE_RUNS=2
# Optional. If omitted, a random token is created once at backend/.qai-api-token.
# Never commit or share this value.
QAI_API_TOKEN=
# Explicit browser origins allowed to bootstrap/use the local UI.
QAI_FRONTEND_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Explicit API Host headers accepted by the local server.
QAI_ALLOWED_API_HOSTS=127.0.0.1:8000,localhost:8000
